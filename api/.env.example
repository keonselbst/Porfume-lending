# Строка подключения к MongoDB (например, кластер MongoDB Atlas — Vercel
# базы данных не хранит, нужен внешний Mongo).
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net

# Название базы данных
DB_NAME=tish

# Опционально: ссылка на внешний магазин, показывается в ответе /api/collection
SHOP_URL=

# Опционально: список разрешённых доменов для CORS через запятую.
# Нужен, только если API дергают с домена, отличного от того, где лежит фронт.
CORS_ORIGINS=
